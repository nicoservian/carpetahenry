# Copiá este archivo como ".env" (sin .example) y completá los datos.
# El archivo .env NO se sube a git.
# Alternativa más segura: guardar las claves en el Administrador de credenciales
# de Windows con:  python herramientas/guardar_credencial.py NOMBRE
#
# Formato: <NOMBRE>_USUARIO y <NOMBRE>_CLAVE, donde NOMBRE es el valor de
# "credencial:" en el config.yaml del proveedor.

DIMAC_USUARIO=
DIMAC_CLAVE=

COMERCIOCITY_USUARIO=
COMERCIOCITY_CLAVE=
